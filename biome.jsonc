{
	"$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
	"vcs": {
		"clientKind": "git",
		"enabled": true,
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!packages/shared/src/gbp/gen",
			"!site/worker-configuration.d.ts"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"a11y": { "noSvgWithoutTitle": "off" },
			"nursery": {
				"useTailwindShorthandClasses": "error",
				"useTailwindSortedClasses": "error"
			},
			"preset": "recommended"
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": {
					"level": "on",
					"options": {
						"groups": [
							[":BUN:", ":NODE:"],
							":BLANK_LINE:",
							[":PACKAGE:", ":PACKAGE_WITH_PROTOCOL:", "!@hina-record/**"],
							":BLANK_LINE:",
							["@hina-record/**", ":ALIAS:", ":PATH:"],
							":BLANK_LINE:"
						]
					}
				},
				"useSortedAttributes": "on",
				"useSortedPackageJson": "on",
				"useSortedProperties": "on"
			}
		},
		"enabled": true
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"tailwind": {
		"stylesheet": "./site/src/styles/global.css",
		"mergeFunctions": ["cn"]
	}
}
