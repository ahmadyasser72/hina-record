{
	"extends": "../tsconfig.base.json",
	"compilerOptions": {
		"jsx": "react-jsx",
		"jsxImportSource": "hono/jsx",
		"lib": ["ESNext", "DOM"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"skipLibCheck": true,
		"strict": true,
		"target": "ESNext",
		"types": ["vite/client", "node", "bun"],

		"paths": {
			"~/*": ["./src/*"]
		}
	}
}
