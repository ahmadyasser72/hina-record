{
	"name": "site",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"gen": "wrangler types"
	},
	"devDependencies": {
		"@fontsource/comic-relief": "5.3.0",
		"@fontsource/kiwi-maru": "5.3.1",
		"@hina-record/shared": "workspace:*",
		"@iconify/svelte": "5.2.4",
		"@skeletonlabs/skeleton": "5.0.4",
		"@skeletonlabs/skeleton-svelte": "5.0.4",
		"@sveltejs/adapter-cloudflare": "8.0.2",
		"@sveltejs/kit": "3.2.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.5",
		"@types/node": "26.6.6",
		"svelte": "5.57.3",
		"svelte-check": "4.7.8",
		"tailwindcss": "4.3.5",
		"typescript": "7.0.2",
		"virtua": "0.54.2",
		"vite": "8.3.8",
		"wrangler": "4.160.0"
	}
}
